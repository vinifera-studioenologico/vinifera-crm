rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == "admin";
    }

    // ── PDF preventivi ────────────────────────────────────────────────
    match /quotes/{quoteId}/quote.pdf {
      allow read: if isAdmin();
      allow write: if false; // solo Admin SDK server-side
    }

    // ── PDF referti ───────────────────────────────────────────────────
    match /reports/{reportId}/report.pdf {
      allow read: if isAdmin();
      allow write: if false; // solo Admin SDK server-side
    }

    // ── Logo azienda ──────────────────────────────────────────────────
    match /settings/logo {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Deny-by-default ───────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
