rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == "admin";
    }

    // ── PDF referti ───────────────────────────────────────────────────
    // Path effettivo: reports/{id}.pdf  (es. reports/abc123.pdf)
    match /reports/{fileName} {
      allow read: if isAdmin();
      allow write: if false; // solo Admin SDK server-side
    }

    // ── Logo azienda ──────────────────────────────────────────────────
    // Path effettivo: company/logo.{ext}  (es. company/logo.png)
    match /company/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── PDF bolle/fatture fornitori ───────────────────────────────────
    // Path effettivo: costs/invoices/{expenseId}.pdf
    // Lettura via signed URL generato server-side — questo blocco è difesa in profondità
    match /costs/invoices/{fileName} {
      allow read: if isAdmin();
      allow write: if false; // solo Admin SDK server-side
    }

    // ── Immagini servizi ──────────────────────────────────────────────
    // Path: services/{serviceId}/{fileName}
    // Lettura: admin (UI CRM preview). Scrittura: solo Admin SDK server-side.
    match /services/{serviceId}/{fileName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Immagini eventi ──────────────────────────────────────────────
    // Path: events/{eventId}/{fileName}
    // Immagini pubbliche (mostrate su vinifera-site) → lettura libera.
    // Scrittura diretta da browser (Client SDK) per bypassare il limite di
    // body size delle Vercel Serverless Functions sui Server Actions.
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches("image/(png|jpeg|webp)");
    }

    // ── Deny-by-default ───────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
