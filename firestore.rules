rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && request.auth.token.role == "admin";
    }

    // ── Deny-by-default ────────────────────────────────────────────────
    // Tutte le collezioni richiedono ruolo admin.
    // Il client SDK non è mai usato per scrivere dati sensibili (solo Admin SDK lato server).

    match /clients/{clientId} {
      allow read, write: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    match /analyses/{analysisId} {
      allow read, write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read, write: if isAdmin();
    }

    match /clientPackages/{pkgId} {
      allow read, write: if isAdmin();
    }

    match /samples/{sampleId} {
      allow read, write: if isAdmin();
    }

    match /quotes/{quoteId} {
      allow read, write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();

      match /installments/{installmentId} {
        allow read, write: if isAdmin();
      }

      match /transactions/{txId} {
        allow read, write: if isAdmin();
      }
    }

    match /reminders/{reminderId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    match /costExpenses/{id} {
      allow read, write: if isAdmin();
    }

    match /costFixedCosts/{id} {
      allow read, write: if isAdmin();
    }

    match /costKits/{id} {
      allow read, write: if isAdmin();
    }

    // Servizi — admin gestisce, API pubblica usa Admin SDK (bypassa le rules)
    match /services/{serviceId} {
      allow read, write: if isAdmin();
    }

    // Lead — admin legge/aggiorna, API pubblica usa Admin SDK per scrivere
    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }

    // ── Modulo eventi ────────────────────────────────────────────────
    // Tutte le scritture da API pubblica passano dall'Admin SDK (bypassa le rules).

    match /events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /eventOrders/{orderId} {
      allow read, write: if isAdmin();

      match /transactions/{txId} {
        allow read, write: if isAdmin();
      }
    }

    match /eventSubscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    // Rate limit — scritto dall'Admin SDK nei percorsi pubblici
    match /rateLimits/{limitId} {
      allow read, write: if isAdmin();
    }

    // ── Fallback: nega tutto il resto ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
